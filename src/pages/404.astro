---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <main class="pad not-found">
    <p class="muted">404</p>
    <h1>Nothing at this address.</h1>
    <a href="/" class="muted">Back to the work <span aria-hidden="true">→</span></a>
  </main>
</Base>

<style>
  .not-found { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; font-size: clamp(1rem, 1.6vw, 1.5rem); font-weight: 500; }
  .not-found p, .not-found h1 { margin: 0; }
  .not-found h1 { max-width: 12ch; margin-block: 1rem 3rem; font-size: clamp(3.5rem, 9vw, 9rem); font-weight: 500; letter-spacing: -0.07em; line-height: 0.9; }
  .not-found a:hover { color: var(--ink); }
</style>
