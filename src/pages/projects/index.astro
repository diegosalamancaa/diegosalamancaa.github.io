---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { CATEGORIES } from '../../content.config';

const projects = await getProjects();
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, projects.filter((p) => p.data.category === c).length]));
---

<Base title="Projects" description="Propulsion, robotics, research, and leadership projects.">
  <h1>Projects</h1>
  <div class="filters" role="group" aria-label="Filter by category">
    <button type="button" data-filter="all" aria-pressed="true">All <span>{projects.length}</span></button>
    {
      CATEGORIES.map((c) => (
        <button type="button" data-filter={c} aria-pressed="false">
          {c} <span>{counts[c]}</span>
        </button>
      ))
    }
  </div>
  <div class="grid" id="project-grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid [data-category]');

  function apply(filter: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    cards.forEach((c) => (c.hidden = filter !== 'all' && c.dataset.category !== filter));
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter ?? 'all';
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `#${f.toLowerCase()}`);
    }),
  );

  const fromHash = [...buttons].find((b) => b.dataset.filter?.toLowerCase() === location.hash.slice(1));
  if (fromHash) apply(fromHash.dataset.filter!);
</script>
