---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Field from '../../components/Field.astro';
import { getProjects } from '../../lib/projects';
import { CATEGORIES } from '../../content.config';

const projects = await getProjects();
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, projects.filter((p) => p.data.category === c).length]));
---

<Base title="Index" description="All projects: propulsion, robotics, research, and leadership.">
  <SiteHeader />
  <main class="page-shell pad">
    <p class="eyebrow">Index</p>
    <h1 class="page-title">All projects</h1>

    <div class="filters" role="group" aria-label="Filter by category">
      <button type="button" data-filter="all" aria-pressed="true">All<sup>{projects.length}</sup></button>
      {CATEGORIES.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}<sup>{counts[c]}</sup></button>)}
    </div>

    <div class="index-list">
      {
        projects.map((p) => (
          <a class="index-row" href={`/projects/${p.id}/`} data-category={p.data.category}>
            <h2>{p.data.title}</h2>
            <span class="meta">{p.data.category} · <Field value={p.data.dates} /></span>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('.index-row');

  function apply(filter: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    rows.forEach((r) => (r.hidden = filter !== 'all' && r.dataset.category !== filter));
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter ?? 'all';
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `#${f.toLowerCase()}`);
    }),
  );

  const fromHash = [...buttons].find((b) => b.dataset.filter?.toLowerCase() === location.hash.slice(1));
  if (fromHash) apply(fromHash.dataset.filter!);
</script>
