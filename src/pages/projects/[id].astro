---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Reel from '../../components/Reel.astro';
import Field from '../../components/Field.astro';
import { getProjects, reelImages } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { id: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, role, dates, category, summary, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary.startsWith('TODO') ? undefined : summary}>
  <SiteHeader />
  <main class="page-shell pad">
    <p class="eyebrow"><a href={`/projects/#${category.toLowerCase()}`}>{category}</a></p>
    <h1 class="page-title">{title}</h1>
    <p class="project-summary"><Field value={summary} /></p>

    <dl class="detail-meta">
      <div><dt>Role</dt><dd><Field value={role} /></dd></div>
      <div><dt>Dates</dt><dd><Field value={dates} /></dd></div>
      <div><dt>Category</dt><dd>{category}</dd></div>
    </dl>

    <div class="runway">
      <Reel images={reelImages(project)} label={title} eager />
      {links.length > 0 && (
        <div>
          {links.map((l) => (
            <a class="doc-row" href={l.href}><strong>{l.label}</strong><span aria-hidden="true">↗</span></a>
          ))}
        </div>
      )}
    </div>

    <article class="prose">
      <Content />
    </article>

    <nav class="next-nav" aria-label="Next project">
      <a class="doc-row" href={`/projects/${next.id}/`}>
        <strong><span class="muted">Next</span> {next.data.title}</strong>
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </main>
</Base>

<style>
  .project-summary { margin-top: clamp(2.5rem, 5vw, 4.5rem); }
</style>
