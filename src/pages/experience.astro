---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import { experience, education } from '../data/experience';
---

<Base title="Experience" description="Roles in propulsion, robotics research, and leadership.">
  <h1>Experience</h1>

  <ol class="timeline">
    {
      experience.map((r) => (
        <li>
          <span class="label when"><Field value={r.dates} /></span>
          <div>
            <h2>{r.title}</h2>
            <p class="org">{r.org}</p>
            <ul>
              {r.points.map((pt) => <li><Field value={pt} /></li>)}
            </ul>
            {r.project && <a class="label" href={`/projects/${r.project}/`}>Project page</a>}
          </div>
        </li>
      ))
    }
  </ol>

  <h2 class="edu-head">Education</h2>
  <p>{education.school}<br /><Field value={education.degree} /></p>
</Base>

<style>
  .timeline { list-style: none; padding: 0; margin: 3rem 0 0; border-left: 1px solid var(--line); }
  .timeline > li { display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; padding: 0 0 3rem 1.75rem; position: relative; }
  .timeline > li::before {
    content: ''; position: absolute; left: -4px; top: 0.45rem;
    width: 7px; height: 7px; background: var(--accent);
  }
  .when { padding-top: 0.2rem; }
  .timeline h2 { font-size: 1.125rem; margin: 0; }
  .org { margin: 0.15rem 0 0.6rem; color: var(--muted); }
  .timeline ul { margin: 0 0 0.75rem; padding-left: 1.1rem; max-width: var(--prose); }
  .timeline ul li { margin-bottom: 0.3rem; }
  .edu-head { margin-top: 2rem; }
  @media (max-width: 40rem) {
    .timeline > li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
