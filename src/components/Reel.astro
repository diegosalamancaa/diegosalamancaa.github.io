---
// Horizontal scroll-snap carousel. Works by swipe/scroll without JS;
// the script adds arrow buttons and the progress dots.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  label: string;
  eager?: boolean;
}
const { images, label, eager = false } = Astro.props;
---

{
  images.length === 0 ? (
    <div class="reel-empty">
      <span class="todo">TODO: images</span>
    </div>
  ) : (
    <figure class="reel" data-reel>
      <div class="reel-track" tabindex="0" role="region" aria-label={`${label} images`}>
        {images.map((img, i) => (
          <div class="reel-slide">
            <Image
              src={img}
              alt={`${label}, image ${i + 1} of ${images.length}`}
              widths={[640, 1200, 1800]}
              sizes="(min-width: 800px) 90vw, 100vw"
              loading={eager && i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
      {images.length > 1 && (
        <div class="reel-controls">
          <button type="button" data-prev aria-label="Previous image">←</button>
          <span class="reel-dots" aria-hidden="true">
            {images.map((_, i) => <i class:list={{ on: i === 0 }} />)}
          </span>
          <button type="button" data-next aria-label="Next image">→</button>
        </div>
      )}
    </figure>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const track = reel.querySelector<HTMLElement>('.reel-track')!;
    const dots = [...reel.querySelectorAll('.reel-dots i')];
    const count = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + count) % count) * track.clientWidth, behavior: 'smooth' });

    reel.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1));
    reel.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
    });
    track.addEventListener('scroll', () => {
      const i = index();
      dots.forEach((d, j) => d.classList.toggle('on', i === j));
    }, { passive: true });
  });
</script>
